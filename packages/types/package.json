{
  "name": "@repo/types",
  "version": "1.0.0",
  "scripts": {
    "build": "bun build --minify --outfile dist/index.js src/index.ts",
    "dev": "bun run build --watch",
    "check-types": "tsc --noemit"
  },
  "private": "true",
  "dependencies": {
    "zod": "catalog:lib"
  },
  "files": [
    "src"
  ],
  "exports": {
