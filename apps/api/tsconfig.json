{
  "extends": "@repo/ts-config/apps.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "strictNullChecks": true,
    "paths": {
      "src/*": ["./src/*"],
      "@emails": ["../../packages/emails/src"],
      "@emails/*": ["../../packages/emails/src/*"],
      "types": ["../../packages/types/src"],
      "types/*": ["../../packages/types/src/*"]
    }
  }
}
