{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core"],
  "files": {
    "includes": ["**/*", "!dist", "!.next", "vite.config.ts"]
  },
  "linter": {
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "useImageSize": "off"
      },
      "nursery": {
        "noIncrementDecrement": "off"
      },
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "warn",
          "options": {
            "style": "interface"
          }
        },
        "noMagicNumbers": "off",
        "noProcessEnv": "error",
        "noExportedImports": "off",
        "noEnum": "off",
        "noRestrictedImports": {
          "options": {
            "patterns": [
              {
                "group": ["../*"],
                "message": "Relative imports are not allowed"
              },
              {
                "group": ["types/*"],
                "message": "Refraing from importing from types"
              },
              {
                "group": ["ui/*"],
                "message": "Refraing from importing from ui"
              }
            ]
          },
          "level": "error"
        }
      },
      "performance": {
        "noBarrelFile": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": true,
    "lineWidth": 120,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "bracketSpacing": true,
      "indentWidth": 2
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
